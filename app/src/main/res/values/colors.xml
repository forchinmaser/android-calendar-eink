<?xml version="1.0" encoding="utf-8"?>
<!--
  TIER 1 — replacement for the EXISTING app/src/main/res/values/colors.xml.

  These names are declared in the app module, so they cannot be overridden from
  colors_eink.xml — a duplicate name in the same module fails the build. They are
  edited in place here instead. Structure and comments are the original file's;
  only the values change.

  The twenty *_base colours stay DECLARED because CalendarFormFragment's colour
  picker and the API's displayColor both reference them, and the server round-trips
  the hex. They are collapsed to ink so nothing renders a hue; calendar identity is
  carried by CalendarPattern, which keys off the ORIGINAL hex values — those live in
  CalendarPattern.BY_HEX, not here.
-->
<resources>
    <!-- global color mapping -->

    <color name="interaction_weak_norm">@color/interaction_weak</color>
    <color name="interaction_weak_disabled_pressed">@color/interaction_weak_pressed</color>
    <color name="splash_screen_color">@color/background_norm</color>

    <!-- colors to use in the app -->

    <color name="textColorValidationError">@color/notification_error</color>

    <!-- constant colors, do not change in dark mode -->
    <!-- Event text sits on paper now, not on a filled colour chip. Inverted text on a
         solid slateblue chip is handled in code (WeekViewCalendarEntity), not here. -->
    <color name="text_on_calendar_color">@color/ink</color>

    <color name="purple_base">@color/ink</color>
    <color name="strawberry_base">@color/ink</color>
    <color name="pink_base">@color/ink</color>
    <color name="carrot_base">@color/ink</color>
    <color name="sahara_base">@color/ink</color>
    <color name="enzian_base">@color/ink</color>
    <color name="plum_base">@color/ink</color>
    <color name="cerise_base">@color/ink</color>
    <color name="copper_base">@color/ink</color>
    <color name="soil_base">@color/ink</color>
    <color name="slateblue_base">@color/ink</color>
    <color name="pacific_base">@color/ink</color>
    <color name="reef_base">@color/ink</color>
    <color name="fern_base">@color/ink</color>
    <color name="olive_base">@color/ink</color>
    <color name="cobalt_base">@color/ink</color>
    <color name="ocean_base">@color/ink</color>
    <color name="pine_base">@color/ink</color>
    <color name="forest_base">@color/ink</color>
    <color name="pickle_base">@color/ink</color>
</resources>
